# kasparsleitis.com — plain HTML site deployed from GitHub (leitisk-bit/kasparsleitis.com).
# The old Website Builder files (index.php, ncsitebuilder/) are left on the server but no longer used.

<IfModule pagespeed_module>
	ModPagespeed off
</IfModule>

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType text/html A0
	ExpiresByType image/svg+xml A604800
	ExpiresByType image/png A604800
	ExpiresByType image/jpeg A604800
	ExpiresByType image/webp A604800
	ExpiresByType text/css A3600
	ExpiresByType application/javascript A3600
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.(html|php)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</IfModule>

<FilesMatch "^(web\.config|\.ftp-deploy-sync-state\.json)$">
	Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /
RewriteRule ^\.well-known/.+ - [L]

# Always use HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# /ServerInfo, /SERVERINFO … → /serverinfo/  (admin server overview; data from the home server)
RewriteCond %{REQUEST_URI} !^/serverinfo(/|$)
RewriteRule ^serverinfo(/.*)?$ /serverinfo$1 [R=301,L,NC]
RewriteRule ^serverinfo$ /serverinfo/ [R=301,L]

# /Football, /FOOTBALL … → /football/  (admin football stats; data from the home server)
RewriteCond %{REQUEST_URI} !^/football(/|$)
RewriteRule ^football(/.*)?$ /football$1 [R=301,L,NC]
RewriteRule ^football$ /football/ [R=301,L]

# /telpuo, /TelpuO … → /telpuO/
RewriteCond %{REQUEST_URI} !^/telpuO(/|$)
RewriteRule ^telpuo(/.*)?$ /telpuO$1 [R=301,L,NC]
RewriteRule ^telpuO$ /telpuO/ [R=301,L]
