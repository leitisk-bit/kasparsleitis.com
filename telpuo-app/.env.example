# Copy to .env and choose the admin password (used to upload maps and results).
ADMIN_KEY=change-me

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker install command, the long value after --token).
TUNNEL_TOKEN=

# Server Info page (/serverinfo): slug of an Uptime Kuma status page whose monitors it shows (optional).
KUMA_STATUS_SLUG=
