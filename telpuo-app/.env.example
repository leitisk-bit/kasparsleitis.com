# Copy to .env and choose the admin password (used to upload maps and results).
ADMIN_KEY=change-me

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker install command, the long value after --token).
TUNNEL_TOKEN=

# Server Info page (/serverinfo): slug of an Uptime Kuma status page whose monitors it shows (optional).
KUMA_STATUS_SLUG=

# Strava (optional). From https://www.strava.com/settings/api : Client ID and Client Secret.
# STRAVA_BASE is the public address Strava sends runners back to; its domain must be the Strava app's
# "Authorization Callback Domain" (kasparsleitis.com). The other sites (celi.telpo.lv) work through it.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_BASE=https://telpomarsruts.kasparsleitis.com
