[Unit]
Description=Football stats daily data update

[Service]
Type=oneshot
User=REPLACE_USER
WorkingDirectory=/opt/football
# Limits like the tennis containers, so Jellyfin and the tennis app keep priority.
# Jobs started from the page (update / improve ...) run inside this service, so they share these limits.
CPUQuota=200%
MemoryMax=3G
Nice=10
Environment=OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
ExecStart=/opt/football/.venv/bin/python sync.py update
