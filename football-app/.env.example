# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env

# API-Football key from https://dashboard.api-football.com
API_FOOTBALL_KEY=
# Free plan: 9 (limit 10/min). Pro plan: 280 (limit 300/min)
API_PER_MINUTE=9

# Same admin password as your orienteering replay app.
# Use EITHER the plain password ...
ADMIN_PASSWORD=
# ... OR, if the other app stores a bcrypt hash ($2b$...), paste that hash here instead
ADMIN_PASSWORD_HASH=

# Random string for signing login cookies:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

BASE_PATH=/football
# true when served over https (Cloudflare). Set false only for local http testing.
COOKIE_SECURE=true
